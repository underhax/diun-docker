LOG_LEVEL='warn'
LOG_JSON='false'
DIUN_WATCH_SCHEDULE='0 */6 * * *'

## Ntfy: https://crazymax.dev/diun/config/notif/ntfy/
DIUN_NOTIF_NTFY_PRIORITY='3'
DIUN_NOTIF_NTFY_TIMEOUT='10s'
DIUN_NOTIF_NTFY_TEMPLATETITLE='{{ .Entry.Image }} released'
DIUN_NOTIF_NTFY_TEMPLATEBODY='Docker tag {{ .Entry.Image }} which you subscribed to through {{ .Entry.Provider }} provider has been released.'

## Documentation: https://crazymax.dev/diun/config/notif/
# DIUN_VERSION=latest
